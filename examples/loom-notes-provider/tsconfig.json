{
  // TypeScript config for the demo provider example.
  //
  // Compiles `index.ts` (source) to `index.js` (committed build output).
  // The provider's `package.json` points `loom.provider` at `./index.js`
  // so Loom can `import()` it at runtime without a build step.
  //
  //   npm run build    # one-shot
  //   npm run dev      # tsc --watch
  //
  // Type imports are relative paths into the Loom source tree. When
  // Loom is published to npm, provider authors would write
  // `import type { LoomProviderApi } from "loom"` and add Loom as a
  // peer/dev dependency.
  "compilerOptions": {
    "target": "ES2022",
    // Aligned with the main loom tsconfig so type-only imports into
    // the loom source tree (which uses CJS interop via `esModuleInterop`)
    // resolve consistently. NodeNext is stricter about CJS default
    // imports than the main project's settings and trips on Ajv.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "declaration": false,
    "sourceMap": false,
  },
  "include": ["index.ts"],
}

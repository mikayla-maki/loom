#!/usr/bin/env node
/**
 * Glass builtin: spawn_subagent
 *
 * Invocation modes (probed in order):
 *   1. If $GLASS_INVOKE_TOKEN + $GLASS_INVOKE_SOCKET are set, talk to the
 *      parent Glass over the broker socket (v1 token-broker path).
 *   2. Otherwise (v0 fallback), if $GLASS_PARENT_MANIFEST_DIR is set, look
 *      up the subagent ref in $GLASS_PARENT_SUBAGENT_REGISTRY (a JSON map
 *      shipped by the runtime that lists scope→manifestPath) and run it
 *      in-process via the Glass SDK.
 *   3. Otherwise, treat `scope` as a path and run that agent.toml directly.
 *
 * The tool stays small — most logic lives in the parent runtime / broker.
 */

import { readFileSync } from "node:fs";
import { connect } from "node:net";
import { existsSync } from "node:fs";
import { resolve as resolvePath } from "node:path";

async function main() {
  const input = JSON.parse(readFileSync(0, "utf8"));
  const scope = input?.scope;
  const prompt = input?.prompt;
  if (typeof scope !== "string" || typeof prompt !== "string") {
    console.error("spawn_subagent: 'scope' and 'prompt' are required strings");
    process.exit(2);
  }

  // Mode 1: broker socket
  const token = process.env.GLASS_INVOKE_TOKEN;
  const socket = process.env.GLASS_INVOKE_SOCKET;
  if (token && socket) {
    return await callOverSocket(socket, token, scope, prompt);
  }

  // Mode 2 / 3: in-process Glass
  const registryRaw = process.env.GLASS_SUBAGENT_REGISTRY;
  let manifestPath = null;
  if (registryRaw) {
    try {
      const reg = JSON.parse(registryRaw);
      if (typeof reg[scope] === "string") manifestPath = reg[scope];
    } catch {
      // ignore
    }
  }
  if (!manifestPath) {
    const candidate = resolvePath(scope);
    if (existsSync(candidate)) manifestPath = candidate;
  }
  if (!manifestPath) {
    console.error(
      `spawn_subagent: cannot resolve scope '${scope}'. ` +
        `Set GLASS_SUBAGENT_REGISTRY or pass a path.`,
    );
    process.exit(1);
  }

  const glass = await import("glass").catch(async () => {
    // Fallback: try resolving Glass via the runtime's NODE_PATH.
    const np = process.env.GLASS_RUNTIME_ENTRY;
    if (np) return await import(np);
    throw new Error(
      "spawn_subagent: cannot import glass; runtime should set GLASS_RUNTIME_ENTRY",
    );
  });
  const { runAgent } = glass;
  const agent = await runAgent(manifestPath);
  try {
    await agent.prompt(prompt);
    const events = await agent.session.getEvents();
    const final = [...events]
      .reverse()
      .find((e) => e.sessionUpdate === "agent_message_chunk");
    const text =
      final && final.content && final.content.type === "text" ? final.content.text : "";
    process.stdout.write(text);
  } finally {
    await agent.close();
  }
}

function callOverSocket(socketPath, token, scope, prompt) {
  return new Promise((resolveP, rejectP) => {
    const sock = connect(socketPath);
    let buf = "";
    sock.on("connect", () => {
      const msg = {
        jsonrpc: "2.0",
        id: 1,
        method: "session/prompt",
        params: { token, scope, prompt },
      };
      sock.write(JSON.stringify(msg) + "\n");
    });
    sock.on("data", (b) => {
      buf += b.toString("utf8");
      let nl;
      while ((nl = buf.indexOf("\n")) >= 0) {
        const line = buf.slice(0, nl);
        buf = buf.slice(nl + 1);
        if (!line.trim()) continue;
        try {
          const m = JSON.parse(line);
          if (m.id === 1) {
            sock.end();
            if (m.error) {
              process.stderr.write(`spawn_subagent broker error: ${m.error.message}\n`);
              process.exit(1);
            }
            const text = m.result?.finalMessage ?? "";
            process.stdout.write(String(text));
            resolveP();
            return;
          }
        } catch {
          // ignore non-JSON lines
        }
      }
    });
    sock.on("error", (err) => {
      rejectP(err);
    });
  });
}

main().catch((e) => {
  console.error(`spawn_subagent: ${e.message}`);
  process.exit(1);
});

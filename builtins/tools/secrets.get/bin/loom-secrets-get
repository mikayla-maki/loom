#!/usr/bin/env node
/**
 * Glass builtin: secrets.get
 *
 * Reads `{ name }` on stdin. Looks up the value in $GLASS_SECRETS_JSON
 * (a JSON object the runtime sets at spawn time, scoped by the agent's
 * [sandbox].secrets ceiling). Prints the value, or exits 1 if missing.
 */

import { readFileSync } from "node:fs";

const input = JSON.parse(readFileSync(0, "utf8"));
const name = input?.name;
if (typeof name !== "string" || !name) {
  console.error("secrets.get: 'name' is required");
  process.exit(2);
}
const raw = process.env.GLASS_SECRETS_JSON;
if (!raw) {
  console.error("secrets.get: no secrets store available");
  process.exit(1);
}
let store;
try {
  store = JSON.parse(raw);
} catch (e) {
  console.error(`secrets.get: invalid GLASS_SECRETS_JSON: ${e.message}`);
  process.exit(1);
}
const v = store[name];
if (v === undefined || v === null) {
  console.error(`secrets.get: secret '${name}' not found in agent ceiling`);
  process.exit(1);
}
process.stdout.write(String(v));

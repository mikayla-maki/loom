{
  "name": "@mcmaki/loom",
  "version": "0.2.0",
  "description": "Loom — A manifest-driven agent meta-harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./acp": {
      "import": "./dist/acp/index.js",
      "types": "./dist/acp/index.d.ts"
    }
  },
  "bin": {
    "loom": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "agent",
    "llm",
    "harness",
    "acp",
    "anthropic",
    "openai",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikayla-maki/loom.git"
  },
  "bugs": {
    "url": "https://github.com/mikayla-maki/loom/issues"
  },
  "homepage": "https://github.com/mikayla-maki/loom#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mcmaki/loom-capabilities": "^0.2.0",
    "@mcmaki/loom-sandbox": "^0.2.0",
    "@agentclientprotocol/sdk": "^0.21.0",
    "@anthropic-ai/sdk": "^0.95.1",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "openai": "^6.37.0",
    "seedrandom": "^3.0.5",
    "toml": "^4.1.1",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/seedrandom": "^3.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
